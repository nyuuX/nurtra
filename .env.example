# =====================================================================
# DefisitKu — application configuration
# Copy this file to `.env` and fill in the values you need.
# =====================================================================

# --- Atria Dawn (AI engine) ------------------------------------------
# Text-only model. All requests are JSON/chat-completions; never send
# binary image data to this endpoint.
ATRIA_API_KEY=sk-your-atria-key-here
ATRIA_BASE_URL=https://api.atria-asi.ai/v1
ATRIA_MODEL=Atria-Dawn-Preview

# --- Gemini (vision provider) -------------------------------------------
# Atria Dawn is text-only, so the photo -> nutrition feature uses Gemini's
# OpenAI-compatible endpoint. Free tier via https://aistudio.google.com/apikey
# Key + model are optional: without them the photo route degrades to the
# deterministic local fallback instead of failing.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Server -----------------------------------------------------------
PORT=8000
HOST=127.0.0.1

# Timezone for the daily log boundary. The app rolls to a new day at 00:00 in
# this zone (not 00:00 UTC), so meals logged before dawn belong to the
# previous local day. Needs the tzdata package on Windows/Linux minimal images.
TZ=Asia/Jakarta

# If "demo", the AI routes return deterministic local fallback data so the
# app is fully usable without a valid Atria key. Switch to "atria" once a
# key is set.
AI_MODE=atria
